# Copy this file to .env (git ignores .env) and fill it in.
# The relay reads it when it starts.

# Automatic texts to the trusted circle (Twilio)
SMS_ENABLED=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM_NUMBER=+15555550100
SMS_REMINDER_MINUTES=5

# Daily AI summary (optional)
AI_SUMMARY_ENABLED=false
ANTHROPIC_API_KEY=
