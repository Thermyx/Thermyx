# Copy to .env (git-ignored) and fill in. The relay reads .env at startup;
# variables already set in the environment win. Never put the Claude key in
# the app: anything shipped in the app can be pulled out of it.

PORT=8787
DATABASE_FILE=./data/thermyx.sqlite

# AI Insights: the once-a-day summary written by Claude.
AI_SUMMARY_ENABLED=true
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5

# Texting trusted contacts (off until tested with real phones).
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CONTACT_VERIFICATION_ENABLED=false
