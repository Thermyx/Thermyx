{
  "name": "thermyx-alert-relay",
  "version": "2.0.0",
  "private": true,
  "description": "Prototype alert relay for the Thermyx insole app",
  "main": "server.js",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "demo": "DATABASE_FILE=./data/demo.sqlite node --disable-warning=ExperimentalWarning server.js",
    "admin": "node --disable-warning=ExperimentalWarning admin.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
